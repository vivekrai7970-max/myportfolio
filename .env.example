# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration - SQLite (Default) or MongoDB (Optional)
# Default: SQLite (no setup required, database is db.sqlite3)
DB_ENGINE=sqlite3

# To use MongoDB instead, set DB_ENGINE=djongo and uncomment MongoDB settings below:
# DB_ENGINE=djongo
# DB_NAME=portfolio_db
# DB_HOST=mongodb://127.0.0.1:27017/
# DB_USER=
# DB_PASSWORD=
# DB_AUTH_SOURCE=admin

# For MongoDB Atlas (cloud-hosted, recommended for production):
# DB_HOST=mongodb+srv://username:password@cluster.mongodb.net/
# DB_USER=your-username
# DB_PASSWORD=your-password
# DB_AUTH_SOURCE=admin

# CSRF Settings
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Email Configuration (Console by default for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost

# For production SMTP (example):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password


