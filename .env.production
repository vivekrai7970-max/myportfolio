# Production Environment Configuration for Render
# DO NOT commit this file to GitHub - it's for reference only

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=myportfolio.onrender.com

# Database - SQLite for Render free tier
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@myportfolio.onrender.com
PORTFOLIO_CONTACT_EMAIL=vivekray7970@gmail.com

# CSRF Settings
DJANGO_CSRF_TRUSTED_ORIGINS=https://myportfolio.onrender.com

# Rate Limiting
PORTFOLIO_CONTACT_RATE_LIMIT=5/h
